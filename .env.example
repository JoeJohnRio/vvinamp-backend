# Copy to .env and fill in real values. Never commit .env.
ENV=development
HOST=your-value-here
PORT=your-value-here
LANGUAGE=your-value-here
GRAPIHQL_ENABLE=your-value-here

# Database
DATABASE_URL=your-value-here
POSTGRE_URL=your-value-here
DB_HOST=your-value-here
DB_PORT=your-value-here
DB_NAME=your-value-here
DB_USER=your-value-here
DB_PASS=your-value-here
DB_SSL_MODE=your-value-here
REDIS_URL=your-value-here

# Auth
TOKEN_PASSWORD=your-value-here

# Supabase
SUPABASE_URL=your-value-here
SUPABASE_KEY=your-value-here
SUPABASE_SERVICE_ROLE_KEY=your-value-here
SUPABASE_STORAGE_BUCKET=your-value-here

# YouTube
YT_API_KEY=your-value-here
YT_DLP_PATH=your-value-here

# Storage / downloads
BASE_STORAGE_PATH=your-value-here
STORAGE_PATH=your-value-here
LOG_PATH=your-value-here
DOWNLOAD_TIMEOUT=your-value-here
MAX_DOWNLOAD_SIZE=your-value-here

# CORS / TLS
CORS_ALLOW_ORIGINS=your-value-here
CORS_ALLOW_CREDENTIALS=your-value-here
ENABLE_AUTOCERT=your-value-here
