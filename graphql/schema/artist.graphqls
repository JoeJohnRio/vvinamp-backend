type Artist {
  id: ID!
  name: String!
  bio: String
  profileImage: String
  verified: Boolean!
  monthlyListeners: Int!
  albums: [Album!]!
  tracks: [Track!]!
}

type ArtistHeader {
  name: String!
  monthlyListeners: Int!
  imageUrl: String!
  verticalVideoHeaderUrl: String
  isFollowed: Boolean!
  biography: String
  isVerified: Boolean!
}

extend type Query {
    getArtistHeader(id: ID!): ArtistHeader
}