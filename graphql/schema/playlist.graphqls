type Playlist {
  id: ID!
  title: String!
  description: String
  creator: User!
  createdAt: String!
  updatedAt: String
  isPublic: Boolean!
  coverImage: String
  albumCovers: [String!]
  savedCount: Int!
  totalDuration: Int!
  isSavedByMe: Boolean!
}

type PlaylistTrack {
  playlist: Playlist!
  track: Track!
  position: Int!
  addedAt: String!
}

scalar Upload

type PlaylistTrackConnection {
  edges: [PlaylistTrackEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type PlaylistTrackEdge {
  cursor: String!
  node: PlaylistTrack!
}

input CreatePlaylistInput {
  title: String!
  description: String
  isPublic: Boolean = true
  coverImage: String
}

input UpdatePlaylistInput {
  title: String
  description: String
  isPublic: Boolean
  coverImage: String
}

input AddSongToPlaylistInput {
  playlistId: ID!
  trackId: ID!
  position: Int 
}

input RemoveSongFromPlaylistInput {
  playlistId: ID!
  trackId: ID!
}

input RepositionSongInput {
  trackId: ID!
  position: Int!
}

input EditPlaylistInput {
  playlistId: ID!
  deletedTrackIds: [ID!]
  repositionedSongs: [RepositionSongInput!]
}

input SavePlaylistInput {
  playlistId: ID!
}

input UnsavePlaylistInput {
  playlistId: ID!
}

enum PlaylistSortOrder {
  RECENTS
  RECENTLY_ADDED
  ALPHABETICAL
  CREATOR
}

enum PlaylistTrackSortBy {
  TITLE
  ARTIST_NAME
  ALBUM_NAME
  RECENTLY_ADDED
}

type PlaylistConnection {
  edges: [PlaylistEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type PlaylistEdge {
  cursor: String!
  node: Playlist!
}

extend type Query {
  getPlaylist(id: ID!): Playlist

  getPlaylistTracks(playlistId: ID!, sortBy: PlaylistTrackSortBy = RECENTLY_ADDED, first: Int, after: String, last: Int, before: String): PlaylistTrackConnection!

  getMyPlaylists(first: Int, after: String, last: Int, before: String): PlaylistConnection!

  getPlaylistsByUser(userId: ID!, first: Int, after: String, last: Int, before: String): PlaylistConnection!

  getMyPlaylistFeed(first: Int, after: String, last: Int, before: String, sortOrder: PlaylistSortOrder = RECENTS): PlaylistConnection!
}

extend type Mutation {
  createPlaylist(input: CreatePlaylistInput!): Playlist!
  
  updatePlaylist(id: ID!, input: UpdatePlaylistInput!): Playlist!
  
  deletePlaylist(id: ID!): Boolean!
  
  addSongToPlaylist(input: AddSongToPlaylistInput!): Playlist!
  
  removeSongFromPlaylist(input: RemoveSongFromPlaylistInput!): Boolean!
  
  savePlaylist(input: SavePlaylistInput!): Playlist!
  
  unsavePlaylist(input: UnsavePlaylistInput!): Boolean!

  editPlaylist(input: EditPlaylistInput!): Boolean!

  # Upload a playlist cover and return the public URL
  uploadPlaylistCover(playlistId: ID!, file: Upload!): String!

  # Delete a playlist cover file on storage
  deletePlaylistCoverImage(playlistId: ID!): Boolean!
}

