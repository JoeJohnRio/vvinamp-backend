type ListeningHistory {
  id: ID!
  contentId: ID!
  user: User!
  playedAt: DateTime!
  progress: Int
  contentType: ContentType!
  content: ListeningHistoryContent!
}

union ListeningHistoryContent = Track | PodcastEpisode

extend type Query {
  listRecentHistory(limit: Int!): [ListeningHistory]!
}

enum ContentType {
  TRACK
  PODCAST_EPISODE
  PLAYLIST
  PODCAST_SERIES
  ALBUM
  ARTIST
}