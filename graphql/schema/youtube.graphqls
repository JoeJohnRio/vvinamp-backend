extend type Query {
  searchYoutube(query: String!): [SearchResult!]!
  getDownloadTask(id: String!): DownloadTask
  listDownloadTasks: [DownloadTask!]!
}

extend type Mutation {
  startDownload(input: DownloadInput!): DownloadTask!
}

type SearchResult {
  id: ID!
  title: String!
  url: String!
  webpageUrl: String!
  duration: Int
  durationString: String
  viewCount: Int
  channel: String
  thumbnail: String
}

type DownloadTask {
  id: ID!
  title: String
  youtubeUrl: String!
  status: String!
  progress: Int!
  filePath: String
  error: String
  createdAt: DateTimeISO!
  updatedAt: DateTimeISO!
}

input DownloadInput {
  youtubeUrl: String!
}
