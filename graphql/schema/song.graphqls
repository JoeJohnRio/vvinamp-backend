
type Track {
  id: ID!
  title: String!
  duration: Int!
  streamCount: Int!
  audioFileUrl: String!
  albumCoverUrl: String!
  artistName: String!
  explicit: Boolean!
  lyrics: String
  releaseDate: String!
}

type TrackArtist {
  track: Track!
  artist: Artist!
  role: String
}

type Album {
  id: ID!
  title: String!
  artist: Artist!
  releaseDate: String!
  coverArt: String
  genre: Genre
  tracks: [Track!]!
}

type AlbumDetail {
  id: ID!
  title: String!
  artistName: String!
  artistImage: String
  releaseDate: String!
  coverArt: String
  tracks: [Track!]!
  trackCount: Int!
  totalDuration: Int!
}

type Genre {
  id: ID!
  name: String!
  description: String
  albums: [Album!]!
}

extend type Query {
  album(id: ID!): AlbumDetail
}