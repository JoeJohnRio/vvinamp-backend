type PlaybackInfo {
  hlsUrl: String!
  mp3Fallback: String
  durationMs: Int  
}

enum ContextType {
  PLAYLIST
  ALBUM
  ARTIST
  SEARCH_RESULTS 
}

input PlaybackContextInput {
  type: ContextType!
  id: ID           
  trackIds: [ID!]  
}

input PlaybackInput {
  trackId: ID!
  contentType: ContentType
  contentId: ID
}

type TrackMinimal {
  trackId: ID!
  title: String
  artist: String
  coverImageUrl: String
  artistBio: String
  artistProfileImageUrl: String
  artistMonthlyListeners: Int
}

type PlayerQueue {
  currentTrack: TrackMinimal
  previousTrack: [TrackMinimal]!
  upcomingTrack: [TrackMinimal]!
}

type PlaybackState {
  queue: PlayerQueue!        
  playbackInfo: PlaybackInfo! 
}

extend type Query {
  playbackInfo(input: PlaybackInput!): PlaybackInfo!
  playerQueue: PlayerQueue!
}

extend type Mutation {
  playContext(context: PlaybackContextInput!, offsetTrackId: ID!): PlaybackState!
  addToQueue(trackIds: [ID!]!): PlayerQueue!
  clearQueue: PlayerQueue!
  skipToNext: PlaybackState!
  skipToPrevious: PlaybackState!
}