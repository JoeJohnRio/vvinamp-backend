type PlaybackInfo {
  hlsUrl: String!
  mp3Fallback: String
  durationMs: Int  # For progress bars too
}

input PlaybackInput {
  trackId: ID!
  contentType: ContentType
  contentId: ID
}

type PlayerQueue {
  currentTrackId: ID
  upcomingTrackIds: [ID!]!
}

extend type Query {
  playbackInfo(input: PlaybackInput!): PlaybackInfo!
  playerQueue: PlayerQueue!
}

extend type Mutation {
  addToQueue(trackIds: [ID!]!): PlayerQueue!
  clearQueue: PlayerQueue!
  skipToNext: PlayerQueue!
}